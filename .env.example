# ===== VELOX Security - site (variables Netlify) =====
# A mettre dans Netlify > Site settings > Environment variables

# Discord (Developer Portal > ton application)
CLIENT_ID=application_id
CLIENT_SECRET=client_secret_oauth2
DISCORD_TOKEN=token_du_bot

# URL publique du site (sans slash final), ex: https://velox-security.netlify.app
SITE_URL=https://ton-site.netlify.app

# Secret pour signer les sessions (mets une longue chaine aleatoire)
SESSION_SECRET=change_moi_par_une_longue_chaine_aleatoire

# Supabase (le MEME projet que le bot)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=cle_service_role

# Permissions d'invitation du bot (defaut deja bon)
BOT_PERMISSIONS=1099780156598
